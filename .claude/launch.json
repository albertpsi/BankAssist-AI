{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "bankassist-api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "bankassist.api.app:create_app", "--factory", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "bankassist-ui",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "streamlit", "run", "src/bankassist/ui/agentic_app.py", "--server.headless", "true", "--server.port", "8501"],
      "port": 8501
    }
  ]
}
