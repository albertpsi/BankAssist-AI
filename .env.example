# BankAssist AI — environment template
#
# Copy to `.env` and fill in real values. `.env` is git-ignored.
# NEVER commit real keys. NEVER paste a real key into any file in docs/ or src/.

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# "openai" is the initial provider and uses the credential already in your
# environment. "anthropic" is reserved for an optional adapter added later;
# no lab depends on it. See docs/decisions/0005-llm-provider-abstraction.md
LLM_PROVIDER=openai

# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=

# Reserved — only needed if an Anthropic adapter is added later.
# ANTHROPIC_API_KEY=

# --- Model tiers (economical by default) -----------------------------------
# FAST is the default for EVERY operation: intent classification, query
# rewriting, guardrail classification, and routine generation. Use an
# economical model here.
LLM_MODEL_FAST=gpt-4o-mini

# STRONG is OPTIONAL and used only for selected LLM-as-judge evaluation cases.
# Leave it blank to use the fast model everywhere — the system works end to
# end either way. Do not set an expensive model as a general default.
LLM_MODEL_STRONG=

# Verify both ids against the models your account can actually call. Settings
# validate them at startup and fail loudly rather than at first use.

# --- Pricing (USD per 1M tokens) -------------------------------------------
# Used for Lab 7 cost accounting. JSON keyed by model id.
# VERIFY AGAINST CURRENT PUBLISHED PRICING before quoting any cost figure in
# the submission — a cost table built on stale constants is worse than none.
LLM_PRICE_TABLE={"gpt-4o-mini": {"input": 0.15, "output": 0.60}, "text-embedding-3-small": {"input": 0.02, "output": 0.0}}

LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Embeddings (Lab 2 — ADR-0007)
# ---------------------------------------------------------------------------
# Uses OPENAI_API_KEY above. `sentence-transformers` is NOT in this stack.
EMBEDDING_MODEL=text-embedding-3-small
# Must match the dimension of the Pinecone index. Fixed at index creation —
# changing it means rebuilding the index, not just editing this line.
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=100

# ---------------------------------------------------------------------------
# Chunking (Lab 2)
# ---------------------------------------------------------------------------
# CHARACTERS, not tokens — the unit is in the name so it cannot be misread.
# The chunker targets SIZE and accepts a break anywhere in [MIN, MAX].
# OVERLAP must be smaller than MIN or the chunker cannot make progress;
# settings validation enforces that at startup.
CHUNK_SIZE_CHARS=800
CHUNK_MIN_CHARS=700
CHUNK_MAX_CHARS=900
CHUNK_OVERLAP_CHARS=120

# ---------------------------------------------------------------------------
# Retrieval (Lab 2)
# ---------------------------------------------------------------------------
# Plain vector similarity, top 5. Hybrid search, filters, RRF, and reranking
# are Lab 3 and deliberately have no settings here yet.
RETRIEVAL_TOP_K=5

# ---------------------------------------------------------------------------
# Vector store — Pinecone (Lab 2 — ADR-0007)
# ---------------------------------------------------------------------------
# Required before ingestion or retrieval can run. Get it from the Pinecone
# console. The rest of the application, including /health and the whole test
# suite, works without it.
PINECONE_API_KEY=

PINECONE_INDEX_NAME=bankassist-policies
PINECONE_NAMESPACE=bank-policies

# Serverless placement, used only when the index has to be created.
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---------------------------------------------------------------------------
# Storage paths
# ---------------------------------------------------------------------------
# The corpus directory holds markdown/, metadata/, and pdf/ subdirectories.
POLICY_CORPUS_DIR=./data/policies
SQLITE_PATH=./data/bankassist.db
TRACE_DIR=./traces

# ---------------------------------------------------------------------------
# Lab 3 (not implemented yet — listed so the gap is visible, not forgotten)
# ---------------------------------------------------------------------------
# RETRIEVAL_MODE, DENSE_TOP_K, SPARSE_TOP_K, RRF_K, RERANK_TOP_K,
# CONTEXT_TOKEN_BUDGET, and a reranker model — see ADR-0007's open item.

# ---------------------------------------------------------------------------
# Agents
# ---------------------------------------------------------------------------
AGENT_MAX_TURNS=5
AGENT_MAX_TOOL_CALLS=10

# ---------------------------------------------------------------------------
# Guardrails
# ---------------------------------------------------------------------------
GUARDRAILS_ENABLED=true
GUARDRAIL_INPUT_ENABLED=true
GUARDRAIL_OUTPUT_ENABLED=true
GUARDRAIL_FINANCIAL_SAFETY_ENABLED=true
# Confidence above which the LLM classifier's block verdict is honoured.
GUARDRAIL_CLASSIFIER_THRESHOLD=0.7

# ---------------------------------------------------------------------------
# Caching (Lab 7)
# ---------------------------------------------------------------------------
SEMANTIC_CACHE_ENABLED=true
# Cosine similarity above which a stored answer is served. Too low and
# near-miss questions get a confidently wrong answer — worse than a miss.
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL_SECONDS=86400

# Cache ELIGIBILITY allow-list. The cache defaults to BYPASS: only routes
# named here are ever looked up or stored, and anything touching customer
# state (transactions, profiles, disputes, balances) bypasses regardless.
# Adding a route here is a privacy decision — read
# docs/decisions/0006-semantic-cache-eligibility.md first.
SEMANTIC_CACHE_ELIGIBLE_ROUTES=policy,general

# Provider-native prompt caching: keep the prompt prefix byte-stable and
# report the effect where the provider exposes a measurable signal.
PROMPT_CACHE_ENABLED=true

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
TRACING_ENABLED=true
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
